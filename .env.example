# Copy this file to .env and fill in your key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional
# AI_MODEL=claude-opus-5-5
# AI_LIMIT_PER_HOUR=30
# PORT=5173

# Document conversion (Text/HTML/Word/Excel/PPT → PDF). Detected automatically; set only if installed elsewhere.
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# SOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
# CONVERT_LIMIT_PER_HOUR=120

# Set to 1 only when running behind a hosting proxy (Railway, Render, nginx). The Dockerfile sets it.
# TRUST_PROXY=1
